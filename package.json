{
  "name": "dsh-fish-voice",
  "version": "0.5.39-rc.20",
  "description": "鱼应 · Emikosama 开发的第三方 DeepSeek Harness（DSH）语音插件",
  "author": {
    "name": "Emikosama",
    "url": "https://github.com/Emikosama"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./bundle.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./ui/locale/*.json"
  },
  "files": [
    "bundle.mjs",
    "index.mjs",
    "voice-*.mjs",
    "helper/voice_helper.py",
    "helper/whale_asr_wasm.py",
    "whisper-base-catalog.json",
    "whisper-native-catalog.json",
    "vendor/onnxruntime.LICENSE.txt",
    "ui/host.mjs",
    "ui/conversation-*.mjs",
    "ui/conversation-contract.LICENSE",
    "ui/locale/*.json",
    "lib/client.js",
    "cordis.patch.yml",
    "model-catalog.json",
    "scripts/verify_model.py",
    "README.md",
    "docs/install-single-package.md",
    "docs/model-setup.md",
    "docs/package-name-migration.md",
    "docs/issue-review-2026-11-11.md",
    "docs/ui-redesign.md",
    "docs/keyboard-ptt.md",
    "docs/voice-output-contract.md",
    "vendor/edge-tts.cjs",
    "vendor/edge-tts.NOTICES.txt",
    "helper/tts_windows.ps1",
    "docs/tts-onboarding-contract.md",
    "helper/model_compute.py",
    "helper/gpu_hardware_windows.ps1",
    "docs/model-installer.md",
    "docs/gpu-inference.md",
    "docs/setup-ui.md",
    "docs/single-panel-ui.md",
    "docs/windows-regressions.md",
    "docs/interaction-ux-v0511.md",
    "docs/activation-v0512.md",
    "docs/compact-ui-v0513.md",
    "docs/agent-controls-v0514.md",
    "docs/authorization-global-ui-v0515.md",
    "docs/global-voice-control.md",
    "docs/wake-word-v0516.md",
    "docs/upgrade-recovery-v0516.md",
    "runtime-catalog.json",
    "melo-catalog.json",
    "docs/tts-onboarding-v0517.md",
    "docs/secondary-pages-v0518.md",
    "docs/magnetic-layout-v0519.md",
    "docs/exact-effort-probe.md",
    "docs/owner-setting-confirmation.md",
    "helper/wake_pinyin.json.gz",
    "helper/wake_pinyin.LICENSE",
    "docs/phonetic-wake.md",
    "docs/reference-voice-backend.md",
    "docs/dsh-rc3-compatibility.md",
    "docs/python-runtime-binding.md",
    "helper/audio_devices.py",
    "helper/whale_audio_windows.cs",
    "helper/whale_pcm_stream_windows.cs",
    "helper/pcm_stream_windows.ps1",
    "docs/pcm-stream-contract.md",
    "docs/audio-device-selection.md",
    "docs/chat-panel-v0538.md",
    "docs/latency-baseline.md",
    "helper/audio_input_windows.py",
    "qwen-server-catalog.json",
    "docs/resident-qwen-contract.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node ui/scripts/build.mjs",
    "test": "node --test tests/test_*.mjs",
    "test:package": "node --test tests/test_single_package.mjs",
    "pack:release": "npm pack --ignore-scripts",
    "build:contract": "node ui/scripts/build-contract.mjs"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Emikosama/dsh-fish-voice.git"
  },
  "devDependencies": {
    "zod": "4.6.7"
  },
  "keywords": [
    "dsh",
    "voice-assistant",
    "speech-recognition",
    "push-to-talk",
    "wake-word"
  ],
  "homepage": "https://github.com/Emikosama/dsh-fish-voice",
  "bugs": {
    "url": "https://github.com/Emikosama/dsh-fish-voice/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
